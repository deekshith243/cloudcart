NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
DATABASE_URL=postgresql://cloudcart:cloudcart@localhost:5432/cloudcart?schema=public
SEED_ADMIN_PASSWORD=replace-with-a-local-admin-password
SEED_CUSTOMER_PASSWORD=replace-with-a-local-customer-password
REDIS_URL=redis://localhost:6379
REDIS_PRODUCT_TTL_SECONDS=300
REDIS_CATEGORY_TTL_SECONDS=300
REDIS_PRODUCT_LIST_TTL_SECONDS=60
JWT_SECRET=replace-with-a-local-development-secret
JWT_EXPIRES_IN=15m
JWT_ISSUER=cloudcart-api
AWS_REGION=
AWS_S3_BUCKET=cloudcart-product-images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SQS_ORDER_QUEUE_URL=
AWS_SNS_ORDER_TOPIC_ARN=
AWS_OPENSEARCH_ENDPOINT=
